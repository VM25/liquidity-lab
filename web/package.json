{
  "name": "liquidity-paradox-site",
  "private": true,
  "version": "0.1.0",
  "description": "The Liquidity Paradox V1 research website (local build; not published).",
  "type": "module",
  "scripts": {
    "export": "python3 export/build_bundle.py && node scripts/equations.mjs",
    "export:check": "python3 export/build_bundle.py --check",
    "dev": "vite --port 4322",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "node scripts/equations.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs && node scripts/copy-frozen.mjs && node scripts/lint-built.mjs",
    "preview": "vite preview --port 4323 --strictPort",
    "e2e": "playwright test",
    "check": "npm run export:check && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
