{
  "name": "liquidity-paradox-site",
  "private": true,
  "version": "0.1.0",
  "description": "The Liquidity Paradox research website: a Next.js app, deployed on Netlify from the main branch.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "export": "python3 export/build_bundle.py && node scripts/equations.mjs",
    "export:check": "python3 export/build_bundle.py --check",
    "assets": "node scripts/equations.mjs && node scripts/copy-frozen.mjs",
    "predev": "npm run assets",
    "dev": "next dev --port 4322",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "prebuild": "npm run assets",
    "build": "next build && node scripts/lint-built.mjs",
    "start": "next start --port 4323",
    "preview": "next start --port 4323",
    "e2e": "playwright test",
    "check": "npm run export:check && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "katex": "0.19.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
